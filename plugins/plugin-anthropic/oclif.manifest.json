          "multiple": false,
          "type": "option"
        },
        "model": {
          "description": "model",
          "name": "model",
          "required": false,
          "hasDynamicHelp": false,
          "multiple": false,
          "type": "option"
        },
        "response-format": {
          "description": "response-format",
