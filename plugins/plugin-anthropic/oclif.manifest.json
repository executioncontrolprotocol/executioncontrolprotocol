    "anthropic:generate": {
      "aliases": [],
      "args": {},
      "description": "Runs chat completion against the Anthropic Messages API. Accepts images and documents on the final user turn in browser and Node hosts. Requires a configured API key. Supports system prompts, prior turns, and sampling options.\nUse cases:\n- Workflow step analyzes an uploaded image alongside a user question.\n- Browser or server workflow needs long-context chat with document attachments.\nProjections:\n- Use the model text: Take the text field as the generated assistant or step output for downstream steps.",
      "examples": [
        "ecp anthropic generate --prompt <prompt> --system <system> --model <model>"
      ],
      "flags": {
        "json": {
          "description": "Format output as json.",
          "helpGroup": "GLOBAL",
          "name": "json",
          "allowNo": false,
          "type": "boolean"
        },
        "prompt": {
          "description": "prompt",
          "name": "prompt",
          "required": true,
          "hasDynamicHelp": false,
