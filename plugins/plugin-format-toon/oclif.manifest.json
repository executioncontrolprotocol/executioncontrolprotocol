          "description": "target-version",
          "name": "target-version",
          "required": false,
          "hasDynamicHelp": false,
          "multiple": false,
          "type": "option"
        },
        "input": {
          "description": "JSON object for the full input, from a file or stdin (`-`)",
          "name": "input",
          "hasDynamicHelp": false,
          "multiple": false,
          "type": "option"
        }
      },
      "hasDynamicHelp": false,
      "hiddenAliases": [],
