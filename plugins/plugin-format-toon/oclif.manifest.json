{
  "version": "0.14.1",
  "commands": {
    "format-toon:decode": {
      "aliases": [],
      "args": {},
      "description": "Decodes TOON input into the requested target document. Validates the result and returns diagnostics when parsing or schema checks fail.\nUse cases:\n- Import a TOON file back into an editable workflow manifest.\n- Patch pipeline applies TOON-decoded changes to a workflow.\nProjections:\n- Take the decoded document: When success is true, use the result field as the parsed manifest or patch document for authoring or apply.",
      "examples": [
        "ecp format-toon decode --format <format> --targetSchema <targetSchema> --targetVersion <targetVersion>"
      ],
      "flags": {
        "json": {
          "description": "Format output as json.",
          "helpGroup": "GLOBAL",
          "name": "json",
          "allowNo": false,
          "type": "boolean"
        },
        "format": {
          "description": "format",
          "name": "format",
