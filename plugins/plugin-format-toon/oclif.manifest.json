      "pluginAlias": "@executioncontrolprotocol/plugin-format-toon",
      "pluginName": "@executioncontrolprotocol/plugin-format-toon",
      "pluginType": "core",
      "strict": true,
      "summary": "Parse TOON text into an ECP document.",
      "enableJsonFlag": true
    },
    "format-toon:encode": {
      "aliases": [],
      "args": {},
      "description": "Encodes a supported source into TOON for compact interchange or CLI export. Honors encode options such as headers and compact layout.\nUse cases:\n- CLI exports a validated workflow as TOON for sharing.\n- Workflow panel shows a compact TOON view alongside JSON.\nProjections:\n- Take the encoded document: When success is true, use the result field as the TOON text for export, display, or the next decode step.",
      "examples": [
        "ecp format-toon encode --sourceSchema <sourceSchema> --sourceVersion <sourceVersion> --format <format>"
      ],
