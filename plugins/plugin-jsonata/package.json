{
  "name": "@executioncontrolprotocol/jsonata",
  "version": "0.60.0",
  "description": "Optional JSONata transform capability for step-level data reshaping.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "keywords": [
    "ecosystem:ecp-plugin",
    "oclif-plugin"
  ],
  "oclif": {},
  "ecp": {
    "manifest": "./ecp.manifest.json",
    "schema": "./ecp.schema.json"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ecp.manifest.json": "./ecp.manifest.json",
    "./ecp.schema.json": "./ecp.schema.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "ecp.manifest.json",
    "ecp.schema.json"
  ],
  "scripts": {
    "build": "tsc -b && node ../../packages/plugin-sdk/dist/bin/ecp-plugin-manifest.js",
    "check:manifest": "node ../../packages/plugin-sdk/dist/bin/ecp-plugin-manifest.js --check"
  },
  "dependencies": {
    "jsonata": "^2.2.2"
  },
  "peerDependencies": {
    "@executioncontrolprotocol/plugin-sdk": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@executioncontrolprotocol/plugin-sdk": "workspace:*",
    "zod": "catalog:"
  }
}