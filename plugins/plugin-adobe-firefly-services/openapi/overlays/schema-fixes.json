{
  "firefly/firefly-api.json": [
    {
      "path": ["components", "schemas", "ValidationErrorDetail", "properties", "ctx"],
      "value": {
        "type": "object",
        "description": "Additional context about the error (typed overlay).",
        "additionalProperties": { "type": "string" }
      }
    },
    {
      "path": ["components", "schemas", "ExpandImageRequestV3", "properties", "caiClaimVersion"],
      "value": {
        "type": "integer",
        "enum": [1, 2],
        "description": "Content Authenticity Initiative claim version for image inputs. Use 2 when the source image carries a Claim 2.x assertion (for example Firefly-generated outputs)."
      }
    },
    {
      "path": ["components", "schemas", "FillImageRequestV3", "properties", "caiClaimVersion"],
      "value": {
        "type": "integer",
        "enum": [1, 2],
        "description": "Content Authenticity Initiative claim version for image inputs. Use 2 when the source image carries a Claim 2.x assertion (for example Firefly-generated outputs)."
      }
    },
    {
      "path": ["components", "schemas", "GenerateSimilarImagesRequestV3", "properties", "caiClaimVersion"],
      "value": {
        "type": "integer",
        "enum": [1, 2],
        "description": "Content Authenticity Initiative claim version for image inputs. Use 2 when the source image carries a Claim 2.x assertion (for example Firefly-generated outputs)."
      }
    },
    {
      "path": ["components", "schemas", "GenerateObjectCompositeRequestV3", "properties", "caiClaimVersion"],
      "value": {
        "type": "integer",
        "enum": [1, 2],
        "description": "Content Authenticity Initiative claim version for image inputs. Use 2 when the source image carries a Claim 2.x assertion (for example Firefly-generated outputs)."
      }
    },
    {
      "path": ["components", "schemas", "PreciseUpsamplerRequestV3", "properties", "caiClaimVersion"],
      "value": {
        "type": "integer",
        "enum": [1, 2],
        "description": "Content Authenticity Initiative claim version for image inputs. Use 2 when the source image carries a Claim 2.x assertion (for example Firefly-generated outputs)."
      }
    },
    {
      "path": ["components", "schemas", "GenerateImagesRequestV3", "properties", "caiClaimVersion"],
      "value": {
        "type": "integer",
        "enum": [1, 2],
        "description": "Content Authenticity Initiative claim version for image inputs. Use 2 when the request includes style or structure reference images that carry a Claim 2.x assertion."
      }
    },
    {
      "path": ["components", "schemas", "ImageGenerateRequestV3", "properties", "caiClaimVersion"],
      "value": {
        "type": "integer",
        "enum": [1, 2],
        "description": "Content Authenticity Initiative claim version for image inputs. Use 2 when referenceBlobs carry a Claim 2.x assertion."
      }
    }
  ],
  "audio-video/audio-video-api.json": [
    {
      "path": [
        "components",
        "schemas",
        "JobStatus",
        "properties",
        "output",
        "properties",
        "elements",
        "items",
        "properties",
        "controls",
        "items",
        "properties",
        "options"
      ],
      "value": {
        "description": "Available options (object for dropdown; array for checkbox).",
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          {
            "type": "array",
            "items": { "type": "string" }
          }
        ]
      }
    }
  ],
  "substance3d/openapi.yaml": [
    {
      "path": [
        "components",
        "schemas",
        "ffapierrors.FFAPIErrorDetail",
        "properties",
        "error_context"
      ],
      "value": {
        "type": "object",
        "description": "Additional context for the error (typed overlay).",
        "additionalProperties": { "type": "string" }
      }
    },
    {
      "path": ["components", "schemas", "rest_base.Space", "properties", "archiveUrl"],
      "value": {
        "type": "string",
        "format": "uri",
        "description": "URL to fetch the whole space as an archive (usually a ZIP file)."
      }
    },
    {
      "path": [
        "components",
        "schemas",
        "types.MaterialAssign",
        "properties",
        "assignByDefault"
      ],
      "value": {
        "type": "boolean",
        "description": "Set to true to assign this material by default to all geometric primitives."
      }
    },
    {
      "path": [
        "components",
        "schemas",
        "types.MaterialAssign",
        "properties",
        "excludeFromDefault"
      ],
      "value": {
        "type": "array",
        "items": { "type": "string" },
        "description": "List of nodes to exclude from default assignment."
      }
    }
  ]
}
