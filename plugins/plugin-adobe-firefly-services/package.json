{
  "name": "@executioncontrolprotocol/adobe-firefly-services",
  "version": "0.60.0",
  "description": "Adobe Firefly Services APIs (Firefly, Photoshop, Express, InDesign, Illustrator, Substance 3D) as ECP capabilities generated from OpenAPI.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "keywords": [
    "ecosystem:ecp-plugin",
    "oclif-plugin"
  ],
  "oclif": {},
  "ecp": {
    "manifest": "./ecp.manifest.json",
    "schema": "./ecp.schema.json"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ecp.manifest.json": "./ecp.manifest.json",
    "./ecp.schema.json": "./ecp.schema.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "ecp.manifest.json",
    "ecp.schema.json"
  ],
  "scripts": {
    "generate": "node scripts/generate-capabilities.mjs",
    "check:generated": "node scripts/generate-capabilities.mjs --check",
    "build": "node scripts/generate-capabilities.mjs && tsc -b && node ../../packages/plugin-sdk/dist/bin/ecp-plugin-manifest.js",
    "check:manifest": "node ../../packages/plugin-sdk/dist/bin/ecp-plugin-manifest.js --check"
  },
  "peerDependencies": {
    "@executioncontrolprotocol/plugin-sdk": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@executioncontrolprotocol/plugin-sdk": "workspace:*",
    "yaml": "catalog:",
    "zod": "catalog:"
  }
}
