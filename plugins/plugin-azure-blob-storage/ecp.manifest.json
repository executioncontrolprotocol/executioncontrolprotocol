        "type": "object"
      },
      "description": "Fetches one blob into memory and writes it as a run artifact named after the last segment of the blob name, with the blob's Content-Type. Missing blobs fail the step with ECP_PROVIDER_ERROR and status 404.",
      "id": "@executioncontrolprotocol/azure-blob-storage.download",
      "name": "download",
      "projections": [
        "Take `file` (an artifact ref) and pass it to the next step's file input"
      ],
      "returns": {
        "additionalProperties": false,
        "properties": {
          "file": {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "artifact",
                "type": "string"
              },
              "mediaType": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "sizeBytes": {
                "type": "number"
              },
              "uri": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "uri"
            ],
            "type": "object"
          }
        },
        "required": [
          "file"
        ],
        "type": "object"
      },
      "summary": "Download a blob into a run artifact.",
      "useCases": [
        "Bring a stored blob into the run so later steps can read it as a file ref"
      ]
    },
    {
      "accepts": {
        "properties": {
          "blobName": {
            "minLength": 1,
            "type": "string"
          },
          "container": {
            "minLength": 1,
            "type": "string"
          },
          "expiresInSeconds": {
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "type": "integer"
          },
          "permissions": {
            "pattern": "^[racwd]+$",
            "type": "string"
          }
        },
        "required": [
          "blobName"
        ],
        "type": "object"
      },
      "description": "Creates a service SAS URL for an existing or future blob. Defaults to read-only for one hour; `permissions` takes the letters r, a, c, w and d. Needs an account key in the config (a connection string with AccountKey, or accountName and accountKey). The blob is not checked for existence.",
      "id": "@executioncontrolprotocol/azure-blob-storage.sas",
      "name": "sas",
      "projections": [
        "Take `sasUrl` as the link; `expiresOn` says when it stops working"
      ],
      "returns": {
        "additionalProperties": false,
        "properties": {
          "expiresOn": {
            "type": "string"
          },
          "sasUrl": {
            "type": "string"
          }
        },
        "required": [
          "sasUrl",
          "expiresOn"
        ],
        "type": "object"
      },
      "summary": "Mint a signed URL for one blob.",
      "useCases": [
        "Share a stored blob with a person or service for a limited time",
        "Give an external service a write URL (`cw`) to upload a result directly"
      ]
    },
    {
      "accepts": {
        "properties": {
          "blobName": {
            "minLength": 1,
            "type": "string"
          },
          "container": {
            "minLength": 1,
            "type": "string"
          },
          "contentType": {
            "type": "string"
          },
          "createReadSas": {
            "type": "boolean"
          },
          "file": {
            "oneOf": [
              {
                "properties": {
                  "kind": {
                    "const": "file",
                    "type": "string"
                  },
                  "mediaType": {
                    "type": "string"
                  },
                  "path": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "path"
                ],
                "type": "object"
              },
              {
                "properties": {
                  "headers": {
                    "additionalProperties": {
                      "type": "string"
                    },
                    "propertyNames": {
                      "type": "string"
                    },
                    "type": "object"
                  },
                  "kind": {
                    "const": "url",
                    "type": "string"
                  },
                  "mediaType": {
                    "type": "string"
                  },
                  "url": {
                    "format": "uri",
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "url"
                ],
                "type": "object"
              },
              {
                "properties": {
                  "kind": {
                    "const": "artifact",
                    "type": "string"
                  },
                  "mediaType": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "sizeBytes": {
                    "maximum": 9007199254740991,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "uri": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "uri"
                ],
                "type": "object"
              }
            ]
          }
        },
        "required": [
          "file"
        ],
        "type": "object"
      },
      "description": "Reads a file ref (local path, URL or run artifact) and stores it as a block blob, overwriting any blob with the same name. Without `blobName` a random UUID is used; without `container` the config's defaultContainer is used. Set `createReadSas` to also get a one-hour read-only signed URL, which needs an account key in the config. Use `sas` for other permissions or lifetimes.",
      "id": "@executioncontrolprotocol/azure-blob-storage.upload",
      "name": "upload",
      "projections": [
        "Take `blobName` and `container` to address the blob later; `sasUrl` is the shareable link when requested; `blobUrl` works only for public containers"
      ],
      "returns": {
        "additionalProperties": false,
        "properties": {
          "blobName": {
            "type": "string"
          },
          "blobUrl": {
            "type": "string"
          },
          "container": {
            "type": "string"
          },
          "sasUrl": {
            "type": "string"
          }
        },
        "required": [
          "blobName",
          "container",
          "blobUrl"
        ],
        "type": "object"
      },
      "summary": "Upload a file to Azure Blob Storage.",
      "useCases": [
        "Persist generated media or reports so later steps or people can fetch them",
        "Hand a file to an external service that only accepts URLs (with `createReadSas`)"
      ]
    }
  ],
