    "description": "Blob storage for executions that persist media, share time-limited links or bring stored objects into a run as artifacts. The config object holds either a connection string or an account name and key (as secret references), plus an optional default container. Node hosts only.",
    "id": "@executioncontrolprotocol/azure-blob-storage",
    "package": "@executioncontrolprotocol/plugin-azure-blob-storage",
    "summary": "Upload, download and mint SAS URLs for Azure Blob Storage.",
    "version": "2.0.0"
  },
