{
  "$defs": {
    "bounded.accepts": {
      "properties": {
        "text": {
          "maxLength": 40,
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    },
    "bounded.returns": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    },
    "call.accepts": {
      "properties": {
        "capabilityId": {
          "type": "string"
        },
        "config": {
          "type": "string"
        },
        "input": {}
      },
      "required": [
        "capabilityId"
      ],
      "type": "object"
    },
    "call.returns": {
      "additionalProperties": false,
      "properties": {
        "result": {}
      },
      "required": [
        "result"
      ],
      "type": "object"
    },
    "config": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "secret": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "config-echo.accepts": {
      "additionalProperties": false,
      "properties": {},
      "type": "object"
    },
    "config-echo.returns": {
      "additionalProperties": false,
      "properties": {
        "keys": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "secretLength": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        }
      },
      "required": [
        "keys",
        "secretLength"
      ],
      "type": "object"
    },
    "delay.accepts": {
      "properties": {
        "ms": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "ms"
      ],
      "type": "object"
    },
    "delay.returns": {
      "additionalProperties": false,
      "properties": {
        "waitedMs": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        }
      },
      "required": [
        "waitedMs"
      ],
      "type": "object"
    },
    "echo.accepts": {
      "properties": {
        "value": {}
      },
      "type": "object"
    },
    "echo.returns": {
      "additionalProperties": false,
      "properties": {
        "echo": {}
      },
      "required": [
        "echo"
      ],
      "type": "object"
    },
    "fail.accepts": {
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "fail.returns": {
      "additionalProperties": false,
      "properties": {},
      "type": "object"
    },
    "file-roundtrip.accepts": {
      "properties": {
        "file": {
          "properties": {
            "headers": {
              "additionalProperties": {
                "type": "string"
              },
              "propertyNames": {
                "type": "string"
              },
              "type": "object"
            },
            "kind": {
              "enum": [
                "file",
                "url",
                "artifact"
              ],
              "type": "string"
            },
            "mediaType": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "sizeBytes": {
              "type": "number"
            },
            "uri": {
              "type": "string"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      },
      "required": [
        "file"
      ],
      "type": "object"
    },
    "file-roundtrip.returns": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "artifact",
              "type": "string"
            },
            "mediaType": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "sizeBytes": {
              "type": "number"
            },
            "uri": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "uri"
          ],
          "type": "object"
        }
      },
      "required": [
        "artifact"
      ],
      "type": "object"
    },
    "stage.accepts": {
      "properties": {
        "fail": {
          "type": "boolean"
        },
        "handle": {
          "additionalProperties": {},
          "properties": {
            "$state": {
              "type": "string"
            }
          },
          "type": "object"
        },
        "op": {
          "enum": [
            "set",
            "merge",
            "append"
          ],
          "type": "string"
        },
        "value": {}
      },
      "required": [
        "handle",
        "op",
        "value"
      ],
      "type": "object"
    },
    "stage.returns": {
      "additionalProperties": false,
      "properties": {
        "ok": {
          "type": "boolean"
        }
      },
      "required": [
        "ok"
      ],
      "type": "object"
    }
  },
  "$id": "ecp://plugins/@executioncontrolprotocol/test/0.60.0/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
