{
  "name": "@executioncontrolprotocol/workspace",
  "version": "2.0.0",
  "description": "Execution Control Protocol (ECP) — host, engine and plugins",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "clean:coverage": "node scripts/clean-dist.mjs coverage",
    "clean:dist": "node scripts/clean-dist.mjs dist",
    "build": "tsc -b tsconfig.build.json",
    "lint": "eslint . && markdownlint-cli2 && pnpm run lint:yaml",
    "lint:ts": "eslint .",
    "lint:md": "markdownlint-cli2",
    "lint:yaml": "node scripts/lint-yaml.mjs",
    "test:unit": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:coverage:clean": "pnpm run test:coverage && pnpm run clean:coverage",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "test:e2e": "vitest run --project e2e --passWithNoTests",
    "test:app": "playwright test --pass-with-no-tests",
    "test:conformance": "vitest run --project unit packages/engine/test/conformance.test.ts --passWithNoTests",
    "bench": "node bench/run.mjs",
    "check": "pnpm run build && pnpm run lint && pnpm run secrets:scan && pnpm run check:no-file-deps && pnpm run test:coverage && pnpm run test:integration && pnpm run test:e2e && pnpm run test:app",
    "check:no-file-deps": "node scripts/check-no-file-deps.mjs",
    "version:check-vs-npm": "node scripts/check-version-gt-published.mjs",
    "secrets:scan": "secretlint \"**/*\"",
    "changeset": "changeset",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": [
      "secretlint --no-glob"
    ],
    "*.{yml,yaml}": [
      "node scripts/lint-yaml.mjs"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@playwright/test": "^1.49.0",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.4",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "@vitest/coverage-v8": "^4.0.18",
    "ajv": "catalog:",
    "ajv-formats": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-yml": "^3.3.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "markdownlint-cli2": "^0.21.0",
    "playwright": "^1.49.0",
    "secretlint": "^13.0.4",
    "semver": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  }
}
