{
  "$schema": "https://executioncontrolprotocol.dev/schemas/execution.schema.json",
  "schema": "@executioncontrolprotocol.execution",
  "version": "2.0",
  "execution": {
    "id": "localize-banner",
    "label": "Localize campaign banner",
    "description": "Translate text-layer strings with Anthropic when needed, then run a Photoshop Actions UXP script that rewrites matching text layers in the PSD.",
    "accepts": {
      "type": "object",
      "properties": {
        "locale": { "type": "string" },
        "texts": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Map of PSD text-layer name to source string to translate."
        },
        "headline": {
          "type": "string",
          "description": "Optional single string applied to every text layer not listed in texts."
        },
        "sourceImageUrl": { "type": "string" },
        "outputUrl": { "type": "string" }
      },
      "required": ["locale", "sourceImageUrl", "outputUrl"]
    },
    "returns": {
      "type": "object",
      "properties": {
        "translation": { "type": "object" },
        "banner": {
          "type": "object",
          "description": "Photoshop Actions output: png url FileRef when outputs request image/png."
        }
      }
    }
  },
  "steps": [
    {
      "id": "prompt",
      "label": "Build the translation prompt",
      "uses": "@executioncontrolprotocol/core.transform",
      "accepts": {
        "type": "object",
        "properties": {
          "locale": { "type": "string" },
          "texts": { "type": "object" },
          "headline": { "type": ["string", "null"] }
        },
        "required": ["locale"],
        "additionalProperties": false
      },
      "returns": {
        "type": "object",
        "properties": {
          "prompt": { "type": "string" }
        },
        "required": ["prompt"],
        "additionalProperties": false
      },
      "input": {
        "locale": { "$ref": "state.locale" },
        "texts": { "$ref": "state.texts", "optional": true, "fallback": {} },
        "headline": { "$ref": "state.headline", "optional": true, "fallback": null }
      },
      "script": {
        "$script": { "lang": "js", "path": "scripts/translate-prompt.js" }
      },
      "as": "prompt"
    },
    {
      "id": "translate",
      "label": "Translate text layers",
      "uses": "@executioncontrolprotocol/anthropic.generate",
      "config": "anthropic/default",
      "expr": "(state) => state.locale !== 'en'",
      "input": {
        "prompt": {
          "$ref": "state.prompt.prompt"
        },
        "system": "You translate PSD text-layer copy. Reply with a single raw JSON object only. No markdown fences, no commentary."
      },
      "as": "translation",
      "mode": "replace"
    },
    {
      "id": "parsed",
      "label": "Parse model JSON for UXP params",
      "uses": "@executioncontrolprotocol/core.transform",
      "accepts": {
        "type": "object",
        "properties": {
          "locale": { "type": "string" },
          "translation": { "type": "object" },
          "texts": { "type": "object" },
          "headline": { "type": ["string", "null"] }
        },
        "required": ["locale"],
        "additionalProperties": false
      },
      "returns": {
        "type": "object",
        "properties": {
          "texts": { "type": "object" },
          "headline": { "type": ["string", "null"] }
        },
        "required": ["texts", "headline"],
        "additionalProperties": false
      },
      "input": {
        "locale": { "$ref": "state.locale" },
        "translation": { "$ref": "state.translation", "optional": true, "fallback": {} },
        "texts": { "$ref": "state.texts", "optional": true, "fallback": {} },
        "headline": { "$ref": "state.headline", "optional": true, "fallback": null }
      },
      "script": {
        "$script": { "lang": "js", "path": "scripts/parsed-translation.js" }
      },
      "as": "parsed"
    },
    {
      "id": "actions",
      "uses": "@executioncontrolprotocol/adobe-firefly-services.photoshop-actions",
      "config": "adobe-firefly-services/default",
      "input": {
        "image": {
          "kind": "url",
          "url": { "$ref": "state.sourceImageUrl" },
          "mediaType": "image/vnd.adobe.photoshop"
        },
        "options": {
          "uxp": {
            "source": {
              "content": {
                "$script": {
                  "lang": "js",
                  "path": "scripts/relabel-text-layers.uxp.js",
                  "params": {
                    "texts": {
                      "$ref": "state.parsed.texts"
                    },
                    "headline": {
                      "$ref": "state.parsed.headline"
                    }
                  }
                }
              }
            }
          }
        },
        "outputs": [
          {
            "destination": {
              "url": { "$ref": "state.outputUrl" },
              "storageType": "azure"
            },
            "mediaType": "image/png"
          }
        ]
      },
      "as": "banner"
    }
  ]
}
