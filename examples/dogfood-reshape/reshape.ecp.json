{
  "$schema": "https://executioncontrolprotocol.dev/schemas/execution.schema.json",
  "schema": "@executioncontrolprotocol.execution",
  "version": "2.0",
  "execution": {
    "accepts": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              }
            }
          }
        }
      },
      "required": [
        "items"
      ]
    },
    "returns": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "object"
        }
      }
    }
  },
  "steps": [
    {
      "id": "Reshape",
      "uses": "@executioncontrolprotocol/test.echo",
      "input": {
        "value": {
          "$expr": "(state) => ({ title: state.items[0].title, count: state.items.length })"
        }
      },
      "as": "summary"
    }
  ]
}
