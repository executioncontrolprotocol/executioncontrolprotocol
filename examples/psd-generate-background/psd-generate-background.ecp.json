{
  "schema": "@executioncontrolprotocol.execution",
  "version": "2.0",
  "execution": {
    "id": "psd-generate-background",
    "label": "Generate a PSD background and set its text",
    "description": "Generate an image with Firefly from a prompt, place it as the PSD's background layer (filling the canvas), set the headline and subhead text layers, and return hosted PNG and PSD renditions.",
    "accepts": {
      "type": "object",
      "properties": {
        "psdPath": {
          "type": "string",
          "description": "Absolute path to the template PSD on this machine."
        },
        "prompt": {
          "type": "string",
          "description": "What Firefly should generate for the background."
        },
        "headline": {
          "type": "string",
          "description": "New text for the headline layer; omit to keep the PSD's text."
        },
        "subhead": {
          "type": "string",
          "description": "New text for the subhead layer; omit to keep the PSD's text."
        },
        "backgroundLayer": {
          "type": "string",
          "description": "Name of the layer to replace. Default: Background."
        },
        "headlineLayer": {
          "type": "string",
          "description": "Name of the headline text layer. Default: Headline."
        },
        "subheadLayer": {
          "type": "string",
          "description": "Name of the subhead text layer. Default: Subhead."
        }
      },
      "required": [
        "psdPath",
        "prompt"
      ]
    },
    "returns": {
      "type": "object",
      "properties": {
        "background": {
          "type": "object",
          "description": "Firefly product shape: images[] url FileRefs (bind images.0)."
        },
        "banner": {
          "type": "object",
          "description": "Composite outputs: png and psd url FileRefs."
        }
      }
    }
  },
  "steps": [
    {
      "type": "parallel",
      "id": "prepare",
      "label": "Upload the template and generate the background at the same time",
      "branches": [
        [
          {
            "id": "blob",
            "label": "Build the blob name",
            "uses": "@executioncontrolprotocol/core.transform",
            "accepts": {
              "type": "object",
              "properties": {
                "psdPath": { "type": "string" }
              },
              "required": ["psdPath"],
              "additionalProperties": false
            },
            "returns": {
              "type": "object",
              "properties": {
                "blobName": { "type": "string" }
              },
              "required": ["blobName"],
              "additionalProperties": false
            },
            "input": {
              "psdPath": { "$ref": "state.psdPath" }
            },
            "script": {
              "$script": { "lang": "js", "path": "scripts/blob-name.js" }
            },
            "as": "blob"
          },
          {
            "id": "upload",
            "label": "Upload the PSD and sign a read URL",
            "uses": "@executioncontrolprotocol/azure-blob-storage.upload",
            "config": "azure-blob-storage/default",
            "input": {
              "file": {
                "kind": "file",
                "path": {
                  "$ref": "state.psdPath"
                },
                "mediaType": "image/vnd.adobe.photoshop"
              },
              "blobName": {
                "$ref": "state.blob.blobName"
              },
              "contentType": "image/vnd.adobe.photoshop",
              "createReadSas": true
            },
            "as": "upload"
          }
        ],
        [
          {
            "id": "generate",
            "label": "Generate the background with Firefly",
            "uses": "@executioncontrolprotocol/adobe-firefly-services.firefly-generate-images-v3-async",
            "config": "adobe-firefly-services/default",
            "input": {
              "prompt": {
                "$ref": "state.prompt"
              },
              "numVariations": 1,
              "contentClass": "photo",
              "size": {
                "width": 2304,
                "height": 1792
              }
            },
            "as": "background"
          }
        ]
      ]
    },
    {
      "id": "layers",
      "label": "Build composite layer edits",
      "uses": "@executioncontrolprotocol/core.transform",
      "accepts": {
        "type": "object",
        "properties": {
          "background": {
            "type": "object",
            "properties": {
              "kind": { "const": "url" },
              "url": { "type": "string" }
            },
            "required": ["kind", "url"]
          },
          "backgroundLayer": { "type": "string" },
          "headline": { "type": "string" },
          "headlineLayer": { "type": "string" },
          "subhead": { "type": "string" },
          "subheadLayer": { "type": "string" }
        },
        "required": ["background", "backgroundLayer", "headline", "headlineLayer", "subhead", "subheadLayer"],
        "additionalProperties": false
      },
      "returns": {
        "type": "object",
        "properties": {
          "layers": { "type": "array" }
        },
        "required": ["layers"],
        "additionalProperties": false
      },
      "input": {
        "background": { "$ref": "state.background.images.0" },
        "backgroundLayer": { "$ref": "state.backgroundLayer", "optional": true, "fallback": "Background" },
        "headline": { "$ref": "state.headline", "optional": true, "fallback": "" },
        "headlineLayer": { "$ref": "state.headlineLayer", "optional": true, "fallback": "Headline" },
        "subhead": { "$ref": "state.subhead", "optional": true, "fallback": "" },
        "subheadLayer": { "$ref": "state.subheadLayer", "optional": true, "fallback": "Subhead" }
      },
      "script": {
        "$script": { "lang": "js", "path": "scripts/composite-layers.js" }
      },
      "as": "layers"
    },
    {
      "id": "composite",
      "label": "Replace the background and set the text",
      "uses": "@executioncontrolprotocol/adobe-firefly-services.photoshop-create-composite",
      "config": "adobe-firefly-services/default",
      "input": {
        "image": {
          "kind": "url",
          "url": {
            "$ref": "state.upload.sasUrl"
          },
          "mediaType": "image/vnd.adobe.photoshop"
        },
        "edits": {
          "layers": {
            "$ref": "state.layers.layers"
          }
        },
        "outputs": [
          {
            "destination": {
              "validityPeriod": 86400
            },
            "mediaType": "image/png"
          },
          {
            "destination": {
              "validityPeriod": 86400
            },
            "mediaType": "image/vnd.adobe.photoshop"
          }
        ]
      },
      "as": "banner"
    },
    {
      "id": "cleanup-upload",
      "label": "Remove the uploaded template copy from Azure",
      "uses": "@executioncontrolprotocol/azure-blob-storage.delete",
      "config": "azure-blob-storage/default",
      "input": {
        "blobName": {
          "$ref": "state.upload.blobName"
        },
        "ifMissing": "ignore"
      }
    }
  ]
}
