{
  "$schema": "https://executioncontrolprotocol.dev/schemas/execution.schema.json",
  "schema": "@executioncontrolprotocol.execution",
  "version": "2.0",
  "execution": {
    "id": "psd-artboards-renditions",
    "label": "Reflow a PSD into new artboards and render each one",
    "description": "Read a PSD's layout, plan each new artboard size, have Photoshop build the artboards with a UXP script, check the new PSD against the plan, then export one JPEG per artboard: the artboards are found in the new PSD's manifest by layer type (JSONata) and rendered by layer id. Deterministic end to end; the renditions are for whoever reviews the result.",
    "accepts": {
      "type": "object",
      "properties": {
        "psdPath": { "type": "string", "description": "The source PSD on this machine." },
        "sizes": {
          "type": "array",
          "description": "Artboards to create, each { name, width, height, rules? } in pixels; rules override the shared layout rules for that artboard.",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "width": { "type": "integer", "minimum": 1 },
              "height": { "type": "integer", "minimum": 1 },
              "rules": { "type": "object", "description": "Layout overrides for this artboard only." }
            },
            "required": ["name", "width", "height"]
          }
        },
        "rules": {
          "type": "object",
          "description": "Layout overrides for plan-layout.js: margin, gap, textScale, maxTextWidth, anchorX, anchorY, debug."
        }
      },
      "required": ["psdPath"]
    },
    "returns": {
      "type": "object",
      "properties": {
        "reflow": { "type": "object", "description": "psd: the new PSD (url FileRef, captured into the run)." },
        "structure": { "type": "object", "description": "Structural check of the new PSD against the plan; ok is the pass/fail gate." },
        "renditions": { "type": "object", "description": "artboards: [{ name, file }] — one JPEG per artboard, in document order (captured into the run)." }
      }
    }
  },
  "steps": [
    {
      "id": "upload",
      "label": "Publish the PSD so Photoshop can read it",
      "uses": "@executioncontrolprotocol/azure-blob-storage.upload",
      "config": "azure-blob-storage/default",
      "input": {
        "file": { "kind": "file", "path": { "$ref": "state.psdPath" } },
        "contentType": "image/vnd.adobe.photoshop"
      },
      "as": "upload"
    },
    {
      "id": "source-manifest",
      "label": "Read the source layout",
      "uses": "@executioncontrolprotocol/adobe-firefly-services.photoshop-generate-manifest",
      "config": "adobe-firefly-services/default",
      "input": {
        "image": { "$ref": "state.upload.file" }
      },
      "as": "source"
    },
    {
      "id": "plan",
      "label": "Plan each artboard's layout",
      "uses": "@executioncontrolprotocol/core.transform",
      "accepts": {
        "type": "object",
        "properties": {
          "manifest": { "type": "object" },
          "sizes": { "type": "array" },
          "rules": { "type": "object" }
        },
        "required": ["manifest", "sizes", "rules"],
        "additionalProperties": false
      },
      "returns": {
        "type": "object",
        "properties": {
          "source": { "type": "object" },
          "artboards": { "type": "array" },
          "outputs": { "type": "array" },
          "debug": { "type": "boolean" }
        },
        "required": ["source", "artboards", "outputs"],
        "additionalProperties": false
      },
      "input": {
        "manifest": { "$ref": "state.source" },
        "sizes": {
          "$ref": "state.sizes",
          "optional": true,
          "fallback": [
            { "name": "Square 1080", "width": 1080, "height": 1080, "rules": { "textScale": 1.15 } },
            { "name": "Story 1080x1920", "width": 1080, "height": 1920, "rules": { "anchorY": 0.12, "textScale": 1.35 } },
            { "name": "Landscape 1920x1080", "width": 1920, "height": 1080 },
            { "name": "Rectangle 300x250", "width": 300, "height": 250, "rules": { "textScale": 1.8, "margin": 0.12 } }
          ]
        },
        "rules": { "$ref": "state.rules", "optional": true, "fallback": {} }
      },
      "script": {
        "$script": { "lang": "js", "path": "scripts/plan-layout.js" }
      },
      "as": "plan"
    },
    {
      "id": "reflow",
      "label": "Build the artboards in Photoshop",
      "uses": "@executioncontrolprotocol/adobe-firefly-services.photoshop-actions",
      "config": "adobe-firefly-services/default",
      "input": {
        "image": { "$ref": "state.upload.file" },
        "options": {
          "uxp": {
            "source": {
              "content": {
                "$script": {
                  "lang": "js",
                  "path": "scripts/reflow-artboards.uxp.js",
                  "params": {
                    "plan": { "$ref": "state.plan" }
                  }
                }
              }
            }
          }
        },
        "outputs": { "$ref": "state.plan.outputs" }
      },
      "as": "reflow"
    },
    {
      "id": "cleanup-upload",
      "label": "Remove the uploaded copy",
      "uses": "@executioncontrolprotocol/azure-blob-storage.delete",
      "config": "azure-blob-storage/default",
      "input": {
        "blobName": { "$ref": "state.upload.blobName" },
        "ifMissing": "ignore"
      }
    },
    {
      "id": "inspect",
      "label": "Read the new PSD's layout",
      "uses": "@executioncontrolprotocol/adobe-firefly-services.photoshop-generate-manifest",
      "config": "adobe-firefly-services/default",
      "input": {
        "image": { "$ref": "state.reflow.psd" }
      },
      "as": "result"
    },
    {
      "id": "structure",
      "label": "Check the new PSD against the plan",
      "uses": "@executioncontrolprotocol/core.transform",
      "accepts": {
        "type": "object",
        "properties": {
          "manifest": { "type": "object" },
          "plan": { "type": "object" }
        },
        "required": ["manifest", "plan"],
        "additionalProperties": false
      },
      "returns": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" },
          "errors": { "type": "array", "items": { "type": "string" } },
          "problems": { "type": "array", "items": { "type": "string" } },
          "artboards": { "type": "array" },
          "layerTypes": { "type": "array" },
          "notes": { "type": "string" }
        },
        "required": ["ok", "errors", "problems", "artboards"],
        "additionalProperties": false
      },
      "input": {
        "manifest": { "$ref": "state.result" },
        "plan": { "$ref": "state.plan" }
      },
      "script": {
        "$script": { "lang": "js", "path": "scripts/check-structure.js" }
      },
      "as": "structure"
    },
    {
      "id": "artboards",
      "label": "Find the artboards and list one rendition each",
      "uses": "@executioncontrolprotocol/jsonata.transform",
      "accepts": {
        "type": "object",
        "properties": {
          "manifest": { "type": "object" }
        },
        "required": ["manifest"],
        "additionalProperties": false
      },
      "returns": {
        "type": "object",
        "properties": {
          "names": { "type": "array", "items": { "type": "string" } },
          "outputs": { "type": "array" }
        },
        "required": ["names", "outputs"],
        "additionalProperties": false
      },
      "expression": "( $boards := manifest.layers[type = 'artboard']; { 'names': [$boards.name], 'outputs': [$boards.{ 'destination': { 'validityPeriod': 86400 }, 'mediaType': 'image/jpeg', 'quality': 'high', 'layers': [{ 'id': id }], 'cropMode': 'layer_bounds' }] } )",
      "input": {
        "manifest": { "$ref": "state.result" }
      },
      "as": "artboards"
    },
    {
      "id": "render",
      "label": "Render each artboard as a JPEG",
      "uses": "@executioncontrolprotocol/adobe-firefly-services.photoshop-create-composite",
      "config": "adobe-firefly-services/default",
      "input": {
        "image": { "$ref": "state.reflow.psd" },
        "outputs": { "$ref": "state.artboards.outputs" }
      },
      "as": "rendered"
    },
    {
      "id": "renditions",
      "label": "Name each rendition after its artboard",
      "uses": "@executioncontrolprotocol/jsonata.transform",
      "accepts": {
        "type": "object",
        "properties": {
          "names": { "type": "array", "items": { "type": "string" } },
          "rendered": { "type": "object" }
        },
        "required": ["names", "rendered"],
        "additionalProperties": false
      },
      "returns": {
        "type": "object",
        "properties": {
          "artboards": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "file": { "type": "object" }
              },
              "required": ["name", "file"]
            }
          }
        },
        "required": ["artboards"],
        "additionalProperties": false
      },
      "expression": "{ 'artboards': [$map(names, function($name, $i) { { 'name': $name, 'file': $lookup(rendered, $i = 0 ? 'jpeg' : 'jpeg' & $string($i + 1)) } })] }",
      "input": {
        "names": { "$ref": "state.artboards.names" },
        "rendered": { "$ref": "state.rendered" }
      },
      "as": "renditions"
    }
  ]
}
