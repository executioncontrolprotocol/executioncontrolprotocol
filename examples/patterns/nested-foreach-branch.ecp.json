{
  "$schema": "https://executioncontrolprotocol.dev/schemas/execution.schema.json",
  "schema": "@executioncontrolprotocol.execution",
  "version": "2.0",
  "execution": {
    "id": "pattern-nested-foreach-branch",
    "label": "Nested: forEach > branch > parallel / while",
    "accepts": {
      "type": "object",
      "properties": {
        "orders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "express-1",
            "standard-2",
            "express-3"
          ]
        }
      }
    }
  },
  "steps": [
    {
      "type": "loop",
      "id": "each-order",
      "label": "For each order",
      "mode": "forEach",
      "input": {
        "items": {
          "$ref": "state.orders"
        }
      },
      "as": "order",
      "concurrency": 2,
      "steps": [
        {
          "type": "if",
          "id": "shipping",
          "label": "Shipping speed",
          "accepts": {
            "type": "object",
            "properties": {
              "order": {
                "type": "string"
              }
            },
            "required": [
              "order"
            ]
          },
          "input": {
            "order": {
              "$ref": "state.order"
            }
          },
          "expression": "String(input.order).startsWith('express')",
          "then": [
            {
              "type": "parallel",
              "id": "express-prep",
              "label": "Prepare express in parallel",
              "paths": [
                [
                  {
                    "id": "pick",
                    "label": "Pick items",
                    "uses": "@executioncontrolprotocol/test.echo",
                    "input": {
                      "value": {
                        "$ref": "state.order"
                      }
                    },
                    "as": "pick"
                  }
                ],
                [
                  {
                    "id": "label-print",
                    "label": "Print label",
                    "uses": "@executioncontrolprotocol/test.echo",
                    "input": {
                      "value": {
                        "$ref": "state.order"
                      }
                    },
                    "as": "label_print"
                  }
                ]
              ]
            }
          ],
          "else": [
            {
              "type": "loop",
              "id": "batch-wait",
              "label": "Wait for a batch slot",
              "mode": "for",
              "as": "round",
              "input": { "count": 2 },
              "steps": [
                {
                  "id": "slot",
                  "label": "Check slot",
                  "uses": "@executioncontrolprotocol/test.echo",
                  "input": {
                    "value": {
                      "$ref": "state.order"
                    }
                  },
                  "as": "slot",
                  "mode": "replace"
                }
              ]
            }
          ]
        },
        {
          "id": "ship",
          "label": "Ship order",
          "uses": "@executioncontrolprotocol/test.echo",
          "input": {
            "value": {
              "$ref": "state.order"
            }
          },
          "as": "ship"
        }
      ]
    },
    {
      "id": "notify",
      "label": "Notify all shipped",
      "uses": "@executioncontrolprotocol/test.echo",
      "input": {
        "value": {
          "$ref": "state.ship"
        }
      },
      "as": "notify"
    }
  ]
}
