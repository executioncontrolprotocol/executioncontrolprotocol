{
  "$schema": "https://executioncontrolprotocol.dev/schemas/execution.schema.json",
  "schema": "@executioncontrolprotocol.execution",
  "version": "2.0",
  "execution": {
    "id": "pattern-loop-while",
    "label": "Pattern: while loop"
  },
  "steps": [
    {
      "type": "loop",
      "mode": "while",
      "id": "retry",
      "label": "Retry until ready",
      "expr": "(state) => state.attempt === undefined",
      "maxRounds": 3,
      "steps": [
        {
          "id": "attempt",
          "label": "Attempt",
          "uses": "@executioncontrolprotocol/test.echo",
          "input": {
            "value": "try"
          },
          "as": "attempt",
          "mode": "replace"
        }
      ]
    },
    {
      "id": "after-retry",
      "label": "After the loop",
      "uses": "@executioncontrolprotocol/test.echo",
      "input": {
        "value": {
          "$ref": "state.attempt.echo",
          "optional": true,
          "fallback": "the loop ran zero times"
        }
      },
      "as": "after_retry"
    }
  ]
}
