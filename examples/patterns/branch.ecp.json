{
  "$schema": "https://executioncontrolprotocol.dev/schemas/execution.schema.json",
  "schema": "@executioncontrolprotocol.execution",
  "version": "2.0",
  "execution": {
    "id": "pattern-branch",
    "label": "Pattern: branch",
    "accepts": {
      "type": "object",
      "properties": {
        "tier": {
          "type": "string",
          "enum": [
            "gold",
            "silver",
            "bronze"
          ],
          "default": "gold"
        }
      },
      "required": [
        "tier"
      ]
    }
  },
  "steps": [
    {
      "id": "start",
      "label": "Read tier",
      "uses": "@executioncontrolprotocol/test.echo",
      "input": {
        "value": {
          "$ref": "state.tier"
        }
      },
      "as": "start"
    },
    {
      "type": "if",
      "id": "by-tier",
      "label": "Gold tier?",
      "accepts": {
        "type": "object",
        "properties": {
          "tier": {
            "type": "string"
          }
        },
        "required": [
          "tier"
        ]
      },
      "input": {
        "tier": {
          "$ref": "state.tier"
        }
      },
      "expression": "input.tier === 'gold'",
      "then": [
        {
          "id": "gold-offer",
          "label": "Gold offer",
          "uses": "@executioncontrolprotocol/test.echo",
          "input": {
            "value": "Free express shipping"
          },
          "as": "gold_offer"
        }
      ],
      "else": [
        {
          "type": "if",
          "id": "by-tier-silver",
          "label": "Silver tier?",
          "accepts": {
            "type": "object",
            "properties": {
              "tier": {
                "type": "string"
              }
            },
            "required": [
              "tier"
            ]
          },
          "input": {
            "tier": {
              "$ref": "state.tier"
            }
          },
          "expression": "input.tier === 'silver'",
          "then": [
            {
              "id": "silver-offer",
              "label": "Silver offer",
              "uses": "@executioncontrolprotocol/test.echo",
              "input": {
                "value": "10% off"
              },
              "as": "silver_offer"
            }
          ],
          "else": [
            {
              "id": "default-offer",
              "label": "Default offer",
              "uses": "@executioncontrolprotocol/test.echo",
              "input": {
                "value": "Welcome back"
              },
              "as": "default_offer"
            }
          ]
        }
      ]
    },
    {
      "id": "done",
      "label": "Done",
      "uses": "@executioncontrolprotocol/test.echo",
      "input": {
        "value": "offer chosen"
      },
      "as": "done"
    }
  ]
}
