{
  "$schema": "https://executioncontrolprotocol.dev/schemas/execution.schema.json",
  "schema": "@executioncontrolprotocol.execution",
  "version": "2.0",
  "execution": {
    "id": "pattern-nested-parallel",
    "label": "Nested: parallel > branch > for, and parallel > forEach > parallel",
    "accepts": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "full",
            "quick"
          ],
          "default": "full"
        },
        "passes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "default": 2
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "a.txt",
            "b.txt"
          ]
        }
      }
    }
  },
  "steps": [
    {
      "type": "parallel",
      "id": "work",
      "label": "Two workstreams",
      "paths": [
        [
          {
            "type": "if",
            "id": "depth",
            "label": "How thorough",
            "accepts": {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string"
                }
              },
              "required": [
                "mode"
              ]
            },
            "input": {
              "mode": {
                "$ref": "state.mode"
              }
            },
            "expression": "input.mode === 'full'",
            "then": [
              {
                "type": "loop",
                "id": "passes-loop",
                "label": "Run each pass",
                "mode": "for",
                "input": {
                  "count": {
                    "$ref": "state.passes"
                  }
                },
                "as": "pass",
                "steps": [
                  {
                    "id": "review-pass",
                    "label": "Review pass",
                    "uses": "@executioncontrolprotocol/test.echo",
                    "input": {
                      "value": {
                        "$ref": "state.pass"
                      }
                    },
                    "as": "review_pass",
                    "mode": "replace"
                  }
                ],
                "end": {
                  "input": {}
                }
              }
            ],
            "else": [
              {
                "id": "quick-check",
                "label": "Quick check",
                "uses": "@executioncontrolprotocol/test.echo",
                "input": {
                  "value": {
                    "$ref": "state.mode"
                  }
                },
                "as": "quick_check"
              }
            ]
          }
        ],
        [
          {
            "type": "loop",
            "id": "each-file",
            "label": "For each file",
            "mode": "forEach",
            "input": {
              "items": {
                "$ref": "state.files"
              }
            },
            "as": "file",
            "steps": [
              {
                "type": "parallel",
                "id": "file-checks",
                "label": "Check the file in parallel",
                "paths": [
                  [
                    {
                      "id": "lint",
                      "label": "Lint",
                      "uses": "@executioncontrolprotocol/test.echo",
                      "input": {
                        "value": {
                          "$ref": "state.file"
                        }
                      },
                      "as": "lint"
                    }
                  ],
                  [
                    {
                      "id": "scan",
                      "label": "Scan",
                      "uses": "@executioncontrolprotocol/test.echo",
                      "input": {
                        "value": {
                          "$ref": "state.file"
                        }
                      },
                      "as": "scan"
                    }
                  ]
                ]
              },
              {
                "id": "file-ok",
                "label": "File OK",
                "uses": "@executioncontrolprotocol/test.echo",
                "input": {
                  "value": {
                    "$ref": "state.file"
                  }
                },
                "as": "file_ok"
              }
            ],
            "end": {
              "input": {
                "value": {
                  "$ref": "state.file_ok"
                }
              }
            },
            "into": "checked"
          }
        ]
      ]
    },
    {
      "id": "wrap-up",
      "label": "Wrap up",
      "uses": "@executioncontrolprotocol/test.echo",
      "input": {
        "value": {
          "$ref": "state.checked"
        }
      },
      "as": "wrap_up"
    }
  ]
}
