{
  "schema": "@executioncontrolprotocol.execution",
  "version": "2.0",
  "steps": [
    {
      "type": "loop",
      "id": "items",
      "mode": "forEach",
      "input": {
        "items": {
          "$ref": "state.rows"
        }
      },
      "as": "row",
      "maxRounds": 3,
      "steps": [
        {
          "id": "echo",
          "uses": "@executioncontrolprotocol/test.echo",
          "input": {
            "value": "x"
          },
          "as": "out"
        }
      ],
      "end": {
        "input": {
          "value": {
            "$ref": "state.out"
          }
        }
      },
      "into": "results"
    }
  ]
}
