{
  "schema": "@executioncontrolprotocol.execution",
  "version": "2.0",
  "steps": [
    {
      "id": "markers",
      "uses": "@executioncontrolprotocol/test.echo",
      "input": {
        "value": {
          "top": {
            "$secret": "top"
          },
          "nested": {
            "inner": {
              "$env": "PATH"
            }
          },
          "list": [
            {
              "$env": "HOME"
            }
          ]
        }
      },
      "as": "markers"
    },
    {
      "id": "script",
      "uses": "@executioncontrolprotocol/test.bounded",
      "input": {
        "text": {
          "$script": {
            "lang": "js",
            "source": "'x'",
            "params": {
              "key": {
                "$secret": "in-params"
              }
            }
          }
        }
      },
      "as": "script"
    }
  ]
}