{
  "schema": "@executioncontrolprotocol.execution",
  "version": "2.0",
  "steps": [
    {
      "type": "loop",
      "id": "items",
      "mode": "forEach",
      "ref": "state.rows",
      "as": "row",
      "concurrency": 0,
      "steps": [
        {
          "id": "echo",
          "uses": "@executioncontrolprotocol/test.echo",
          "input": { "value": "x" },
          "as": "out"
        }
      ],
      "collect": "state.out",
      "into": "results"
    }
  ]
}