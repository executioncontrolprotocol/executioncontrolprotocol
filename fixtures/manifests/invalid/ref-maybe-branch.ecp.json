{
  "schema": "@executioncontrolprotocol.execution",
  "version": "2.0",
  "steps": [
    {
      "type": "if",
      "id": "pick",
      "expression": "true",
      "then": [
        {
          "id": "a",
          "uses": "@executioncontrolprotocol/test.echo",
          "input": {
            "value": "a"
          },
          "as": "picked"
        }
      ]
    },
    {
      "id": "use",
      "uses": "@executioncontrolprotocol/test.echo",
      "input": {
        "value": {
          "$ref": "state.picked"
        }
      },
      "as": "use"
    }
  ]
}
