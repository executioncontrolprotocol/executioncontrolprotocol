{
  "schema": "@executioncontrolprotocol.execution",
  "version": "2.0",
  "steps": [
    {
      "type": "loop",
      "id": "rounds",
      "expr": "(state) => false",
      "maxRounds": 1,
      "steps": [
        {
          "id": "body",
          "uses": "@executioncontrolprotocol/test.echo",
          "input": {
            "value": "x"
          },
          "as": "body",
          "mode": "replace"
        }
      ]
    },
    {
      "id": "after",
      "uses": "@executioncontrolprotocol/test.echo",
      "input": {
        "value": {
          "$ref": "state.body"
        }
      },
      "as": "after"
    }
  ]
}
