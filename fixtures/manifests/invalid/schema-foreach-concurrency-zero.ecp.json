{
  "schema": "@executioncontrolprotocol.execution",
  "version": "2.0",
  "steps": [
    {
      "type": "forEach",
      "id": "items",
      "items": { "$ref": "state.rows" },
      "as": "row",
      "concurrency": 0,
      "steps": [
        {
          "id": "echo",
          "uses": "@executioncontrolprotocol/test.echo",
          "input": { "value": "x" },
          "as": "out"
        }
      ],
      "collect": { "$ref": "state.out" },
      "into": "results"
    }
  ]
}