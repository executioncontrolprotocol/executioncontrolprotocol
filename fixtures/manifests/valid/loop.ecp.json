{
  "schema": "@executioncontrolprotocol.execution",
  "version": "2.0",
  "steps": [
    {
      "type": "loop",
      "id": "refine",
      "expr": "(state) => state.tick === undefined",
      "maxRounds": 2,
      "steps": [
        {
          "id": "tick",
          "uses": "@executioncontrolprotocol/test.echo",
          "input": {
            "value": "tick"
          },
          "as": "tick",
          "mode": "replace"
        }
      ]
    }
  ]
}
