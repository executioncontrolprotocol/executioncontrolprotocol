{
  "schema": "@executioncontrolprotocol.execution",
  "version": "2.0",
  "steps": [
    {
      "type": "parallel",
      "id": "outer",
      "paths": [
        [
          {
            "type": "loop",
            "id": "inner",
            "maxRounds": 1,
            "steps": [
              {
                "type": "if",
                "id": "arm",
                "expression": "true",
                "then": [
                  {
                    "id": "arm-empty",
                    "uses": "@executioncontrolprotocol/test.echo",
                    "input": {
                      "value": "noop"
                    }
                  }
                ],
                "else": [
                  {
                    "id": "nested",
                    "uses": "@executioncontrolprotocol/test.echo",
                    "input": {
                      "value": "nested"
                    },
                    "as": "nested",
                    "mode": "replace"
                  }
                ]
              }
            ],
            "end": {
              "input": {
                "repeat": false
              }
            }
          }
        ],
        [
          {
            "id": "side",
            "uses": "@executioncontrolprotocol/test.echo",
            "input": {
              "value": "side"
            },
            "as": "side"
          }
        ]
      ]
    }
  ]
}
