{
  "schema": "@executioncontrolprotocol.execution",
  "version": "2.0",
  "execution": {
    "accepts": {
      "type": "object",
      "properties": {
        "on": {
          "type": "boolean"
        }
      },
      "required": [
        "on"
      ]
    }
  },
  "steps": [
    {
      "type": "if",
      "id": "pick",
      "input": {
        "on": {
          "$ref": "state.on"
        }
      },
      "expression": "input.on === true",
      "then": [
        {
          "id": "yes",
          "uses": "@executioncontrolprotocol/test.echo",
          "input": {
            "value": "yes"
          },
          "as": "yes"
        }
      ],
      "else": [
        {
          "id": "no",
          "uses": "@executioncontrolprotocol/test.echo",
          "input": {
            "value": "no"
          },
          "as": "no"
        }
      ]
    }
  ]
}
