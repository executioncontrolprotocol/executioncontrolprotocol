{
  "schema": "@executioncontrolprotocol.execution",
  "version": "2.0",
  "execution": {
    "accepts": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000,
          "default": 2
        }
      }
    }
  },
  "steps": [
    {
      "type": "loop",
      "mode": "for",
      "id": "rounds",
      "ref": "state.count",
      "as": "i",
      "steps": [
        {
          "id": "tick",
          "uses": "@executioncontrolprotocol/test.echo",
          "input": {
            "value": {
              "$ref": "state.i"
            }
          },
          "as": "last",
          "mode": "replace"
        }
      ]
    }
  ]
}
