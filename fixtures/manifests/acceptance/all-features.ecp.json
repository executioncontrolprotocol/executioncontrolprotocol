{
  "schema": "@executioncontrolprotocol.execution",
  "version": "2.0",
  "execution": {
    "id": "all-features",
    "label": "All features (plugin-test)",
    "accepts": {
      "type": "object",
      "properties": {
        "name": { "type": "string" }
      },
      "required": ["name"]
    },
    "returns": {
      "type": "object",
      "properties": {
        "greeting": {},
        "staged": {},
        "branch": {},
        "bag": {},
        "echo": {},
        "marked": {},
        "scriptedPath": {},
        "scriptedSrc": {},
        "cfg": {},
        "spin": {},
        "lap": {},
        "left": {},
        "right": {}
      }
    }
  },
  "steps": [
    {
      "id": "greet",
      "uses": "@executioncontrolprotocol/core.transform",
      "accepts": {
        "type": "object",
        "properties": {
          "name": { "type": "string" }
        },
        "required": ["name"],
        "additionalProperties": false
      },
      "returns": {
        "type": "object",
        "properties": {
          "value": { "type": "string" }
        },
        "required": ["value"],
        "additionalProperties": false
      },
      "input": {
        "name": { "$ref": "state.name" }
      },
      "script": {
        "$script": {
          "lang": "js",
          "source": "return { value: `hello ${input.name}` }"
        }
      },
      "as": "greeting",
      "mode": "replace"
    },
    {
      "id": "note",
      "uses": "@executioncontrolprotocol/test.stage",
      "input": {
        "handle": { "$state": "history" },
        "op": "append",
        "value": "started"
      },
      "as": "staged",
      "mode": "replace"
    },
    {
      "type": "branch",
      "id": "pick",
      "branches": [
        {
          "label": "named",
          "expr": "(state) => typeof state.name === 'string'",
          "steps": [
            {
              "id": "named",
              "uses": "@executioncontrolprotocol/test.echo",
              "input": { "value": "named" },
              "as": "branch",
              "mode": "replace"
            }
          ]
        },
        {
          "label": "default",
          "steps": [
            {
              "id": "fallback",
              "uses": "@executioncontrolprotocol/test.echo",
              "input": { "value": "default" },
              "as": "branch",
              "mode": "replace"
            }
          ]
        }
      ]
    },
    {
      "id": "mode-create",
      "uses": "@executioncontrolprotocol/test.echo",
      "input": { "value": "a" },
      "as": "bag",
      "mode": "create"
    },
    {
      "id": "mode-replace",
      "uses": "@executioncontrolprotocol/test.echo",
      "input": { "value": "b" },
      "as": "bag",
      "mode": "replace"
    },
    {
      "id": "mode-merge",
      "uses": "@executioncontrolprotocol/test.echo",
      "input": {
        "value": {
          "extra": 1
        }
      },
      "as": "bag",
      "mode": "merge"
    },
    {
      "id": "mode-append",
      "uses": "@executioncontrolprotocol/test.echo",
      "input": { "value": "c" },
      "as": "bag",
      "mode": "append"
    },
    {
      "id": "gated",
      "uses": "@executioncontrolprotocol/test.echo",
      "expr": "(state) => false",
      "input": { "value": "x" },
      "as": "maybe"
    },
    {
      "id": "ref-echo",
      "uses": "@executioncontrolprotocol/test.echo",
      "input": {
        "value": {
          "$ref": "state.maybe",
          "optional": true,
          "fallback": "fallback"
        }
      },
      "as": "echo",
      "mode": "replace"
    },
    {
      "id": "mark",
      "uses": "@executioncontrolprotocol/test.echo",
      "input": {
        "value": {
          "$ref": "state.greeting.value"
        },
        "fromRef": {
          "$ref": "state.greeting.value",
          "optional": true,
          "fallback": "missing"
        },
        "handle": {
          "$state": "history"
        },
        "script": {
          "$script": {
            "lang": "js",
            "source": "1"
          }
        }
      },
      "as": "marked",
      "mode": "replace"
    },
    {
      "id": "script-path",
      "uses": "@executioncontrolprotocol/test.bounded",
      "input": {
        "text": {
          "$script": {
            "lang": "js",
            "path": "../valid/banner.js"
          }
        }
      },
      "as": "scriptedPath",
      "mode": "replace"
    },
    {
      "id": "script-src",
      "uses": "@executioncontrolprotocol/test.bounded",
      "input": {
        "text": {
          "$script": {
            "lang": "js",
            "source": "2"
          }
        }
      },
      "as": "scriptedSrc",
      "mode": "replace"
    },
    {
      "id": "cfg",
      "uses": "@executioncontrolprotocol/test.config-echo",
      "config": "test/default",
      "input": {},
      "as": "cfg",
      "mode": "replace"
    },
    {
      "type": "loop",
      "id": "spinner",
      "expr": "(state) => true",
      "maxRounds": 2,
      "steps": [
        {
          "id": "spin",
          "uses": "@executioncontrolprotocol/test.echo",
          "input": { "value": "spin" },
          "as": "spin",
          "mode": "replace"
        }
      ]
    },
    {
      "type": "loop",
      "id": "refine",
      "expr": "(state) => state.lap === undefined",
      "maxRounds": 4,
      "steps": [
        {
          "id": "lap",
          "uses": "@executioncontrolprotocol/test.echo",
          "input": { "value": "lap" },
          "as": "lap",
          "mode": "replace"
        }
      ]
    },
    {
      "type": "parallel",
      "id": "together",
      "maxConcurrency": 1,
      "branches": [
        [
          {
            "id": "left",
            "uses": "@executioncontrolprotocol/test.echo",
            "input": { "value": "L" },
            "as": "left",
            "mode": "replace"
          }
        ],
        [
          {
            "id": "right",
            "uses": "@executioncontrolprotocol/test.echo",
            "input": { "value": "R" },
            "as": "right",
            "mode": "replace"
          }
        ]
      ]
    }
  ]
}