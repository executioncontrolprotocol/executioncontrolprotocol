{
  "schema": "@executioncontrolprotocol.execution",
  "version": "2.0",
  "execution": {
    "id": "branch-and-loop",
    "label": "Branch and loop demo",
    "accepts": {
      "type": "object",
      "properties": {
        "expand": {
          "type": "boolean"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "expand"
      ]
    },
    "returns": {
      "type": "object",
      "properties": {
        "Seed": {
          "type": "object"
        }
      }
    }
  },
  "steps": [
    {
      "id": "Seed",
      "uses": "@executioncontrolprotocol/test.echo",
      "input": {
        "value": "seed"
      },
      "as": "Seed"
    },
    {
      "type": "if",
      "id": "pick",
      "input": {
        "expand": {
          "$ref": "state.expand"
        }
      },
      "expression": "input.expand === true",
      "then": [
        {
          "id": "expanded",
          "uses": "@executioncontrolprotocol/test.echo",
          "input": {
            "value": "expanded"
          },
          "as": "expanded"
        }
      ],
      "else": [
        {
          "id": "compact",
          "uses": "@executioncontrolprotocol/test.echo",
          "input": {
            "value": "skipped-arm"
          },
          "as": "compact"
        }
      ]
    },
    {
      "type": "if",
      "id": "gated-gate",
      "input": {
        "expand": {
          "$ref": "state.expand"
        }
      },
      "expression": "input.expand === true",
      "then": [
        {
          "id": "gated",
          "uses": "@executioncontrolprotocol/test.echo",
          "input": {
            "value": "only-when-expand"
          },
          "as": "gated"
        }
      ]
    },
    {
      "type": "loop",
      "id": "retry",
      "label": "retry",
      "mode": "for",
      "input": {
        "count": 1
      },
      "as": "i",
      "steps": [
        {
          "id": "tick",
          "uses": "@executioncontrolprotocol/test.echo",
          "input": {
            "value": "tick"
          },
          "as": "tick",
          "mode": "replace"
        }
      ]
    }
  ]
}
