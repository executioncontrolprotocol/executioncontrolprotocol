{
  "$defs": {
    "bounded.accepts": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 40,
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    },
    "bounded.returns": {
      "properties": {
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    },
    "call.accepts": {
      "properties": {
        "capabilityId": {
          "type": "string"
        },
        "input": {}
      },
      "required": [
        "capabilityId",
        "input"
      ],
      "type": "object"
    },
    "call.returns": {
      "properties": {
        "result": {}
      },
      "required": [
        "result"
      ],
      "type": "object"
    },
    "config": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "secret": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "config-echo.accepts": {
      "additionalProperties": false,
      "properties": {},
      "type": "object"
    },
    "config-echo.returns": {
      "properties": {
        "keys": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "secretLength": {
          "type": "integer"
        }
      },
      "required": [
        "keys",
        "secretLength"
      ],
      "type": "object"
    },
    "delay.accepts": {
      "properties": {
        "ms": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "ms"
      ],
      "type": "object"
    },
    "delay.returns": {
      "properties": {
        "waitedMs": {
          "type": "integer"
        }
      },
      "required": [
        "waitedMs"
      ],
      "type": "object"
    },
    "echo.accepts": {
      "properties": {
        "value": {}
      },
      "type": "object"
    },
    "echo.returns": {
      "properties": {
        "echo": {}
      },
      "required": [
        "echo"
      ],
      "type": "object"
    },
    "fail.accepts": {
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "fail.returns": {
      "properties": {},
      "type": "object"
    },
    "file-roundtrip.accepts": {
      "properties": {
        "file": {
          "type": "object"
        }
      },
      "required": [
        "file"
      ],
      "type": "object"
    },
    "file-roundtrip.returns": {
      "properties": {
        "artifact": {
          "type": "object"
        }
      },
      "required": [
        "artifact"
      ],
      "type": "object"
    },
    "stage.accepts": {
      "properties": {
        "handle": {
          "type": "object"
        },
        "op": {
          "enum": [
            "set",
            "merge",
            "append"
          ]
        },
        "value": {}
      },
      "required": [
        "handle",
        "op",
        "value"
      ],
      "type": "object"
    },
    "stage.returns": {
      "properties": {
        "ok": {
          "type": "boolean"
        }
      },
      "required": [
        "ok"
      ],
      "type": "object"
    }
  },
  "$id": "ecp://plugins/@executioncontrolprotocol/test/0.60.0/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
