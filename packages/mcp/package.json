{
  "name": "@executioncontrolprotocol/mcp",
  "version": "0.50.0",
  "description": "MCP server and JIT CLI plugin for ECP (ecp mcp serve)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./oclif": {
      "types": "./dist/oclif.d.ts",
      "import": "./dist/oclif.js"
    }
  },
  "files": [
    "dist",
    "oclif.manifest.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "peerDependencies": {
    "@executioncontrolprotocol/core": "workspace:^",
    "zod": "catalog:"
  },
  "dependencies": {
    "@executioncontrolprotocol/node": "workspace:^",
    "@executioncontrolprotocol/plugin-sdk": "workspace:^",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@oclif/core": "^5.1.8"
  },
  "devDependencies": {
    "@executioncontrolprotocol/core": "workspace:^",
    "@executioncontrolprotocol/plugin-jsonata": "workspace:^",
    "typescript": "catalog:",
    "zod": "catalog:"
  },
  "oclif": {
    "bin": "ecp",
    "dirname": "ecp",
    "topicSeparator": " ",
    "commands": {
      "strategy": "explicit",
      "target": "./dist/oclif.js",
      "identifier": "COMMANDS"
    },
    "topics": {
      "mcp": {
        "description": "Serve ECP as an MCP server"
      }
    }
  },
  "keywords": [
    "ecosystem:ecp-plugin",
    "oclif-plugin"
  ]
}
