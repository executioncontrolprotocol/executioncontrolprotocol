{
  "name": "@executioncontrolprotocol/cli",
  "version": "0.60.0",
  "private": true,
  "description": "ECP command-line interface.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "ecp": "./bin/ecp.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bin/ecp.js": "./bin/ecp.js"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "bin",
    "dist",
    "oclif.manifest.json"
  ],
  "scripts": {
    "build": "tsc -b && node ../../scripts/check-oclif-manifest.mjs --write"
  },
  "dependencies": {
    "@executioncontrolprotocol/engine": "workspace:*",
    "@executioncontrolprotocol/host": "workspace:*",
    "@executioncontrolprotocol/local": "workspace:*",
    "@executioncontrolprotocol/mcp-relay": "workspace:*",
    "@executioncontrolprotocol/protocol": "workspace:*",
    "@oclif/core": "^5.1.8",
    "@oclif/plugin-help": "^6.2.33",
    "@oclif/plugin-not-found": "^3.2.68",
    "@oclif/plugin-plugins": "^5.4.46"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oclif": "^6.0.15",
    "typescript": "catalog:"
  },
  "oclif": {
    "bin": "ecp",
    "dirname": "ecp",
    "topicSeparator": " ",
    "commands": "./dist/commands",
    "scope": "executioncontrolprotocol",
    "pluginPrefix": "plugin",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-plugins",
      "@oclif/plugin-not-found"
    ],
    "hooks": {
      "init": "./dist/hooks/init.js",
      "finally": "./dist/hooks/plugins-changed.js"
    },
    "topics": {
      "host": {
        "description": "The background host that warm commands use; started automatically, or start, stop, reload, and inspect it here."
      },
      "mcp": {
        "description": "Run the MCP stdio relay that forwards retrieve, execute, and commit."
      },
      "plugins": {
        "description": "Install and list ECP provider packages under $ECP_HOME/plugins."
      },
      "secrets": {
        "description": "Store and list secret keys in the OS keychain for $secret references."
      }
    }
  }
}
