{
  "name": "@executioncontrolprotocol/cli",
  "version": "0.51.0",
  "description": "ECP command-line interface",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "ecp": "./bin/ecp.js"
  },
  "files": [
    "bin/ecp.js",
    "bin/run.js",
    "bin/run.cmd",
    "bin/dev.js",
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "start": "node ./bin/dev.js"
  },
  "peerDependencies": {
    "@executioncontrolprotocol/core": "workspace:^",
    "zod": "catalog:"
  },
  "dependencies": {
    "@executioncontrolprotocol/core": "workspace:^",
    "@executioncontrolprotocol/node": "workspace:^",
    "@executioncontrolprotocol/plugin-sdk": "workspace:^",
    "@oclif/core": "^5.1.8",
    "@oclif/plugin-help": "^6.2.33",
    "@oclif/plugin-not-found": "^3.2.68",
    "@oclif/plugin-plugins": "^5.4.46",
    "@oclif/plugin-warn-if-update-available": "^3.1.46",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@executioncontrolprotocol/core": "workspace:^",
    "typescript": "catalog:"
  },
  "oclif": {
    "bin": "ecp",
    "dirname": "ecp",
    "topicSeparator": " ",
    "commands": {
      "strategy": "explicit",
      "target": "./dist/commands.js",
      "identifier": "COMMANDS"
    },
    "scope": "executioncontrolprotocol",
    "pluginPrefix": "plugin",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-plugins",
      "@oclif/plugin-not-found",
      "@oclif/plugin-warn-if-update-available"
    ],
    "hooks": {
      "init": "./dist/hooks/init-host.js",
      "command_not_found": "./dist/hooks/command-not-found.js",
      "jit_plugin_not_installed": "./dist/hooks/jit-install.js",
      "plugins:preinstall": "./dist/hooks/trust.js",
      "plugins:postinstall": "./dist/hooks/postinstall-add-to-env.js"
    },
    "jitPlugins": {
      "@executioncontrolprotocol/mcp": "^0.51",
      "@executioncontrolprotocol/plugin-app": "^0.51"
    }
  }
}
