{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ecp://protocol/retrieve.input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["type"],
  "properties": {
    "type": { "enum": ["capability", "execution", "config", "run", "plugin", "formatter"] },
    "id": { "type": "string", "minLength": 1 },
    "query": { "type": "string", "minLength": 1 },
    "filter": { "type": "object" },
    "include": {
      "type": "array",
      "items": { "enum": ["steps", "events", "manifest", "state"] }
    },
    "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
    "format": { "type": "string" },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": { "path": { "type": "string", "minLength": 1 } }
    }
  },
  "not": { "required": ["id", "query"] }
}
