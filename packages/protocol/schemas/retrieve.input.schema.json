{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ecp://protocol/retrieve.input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["type"],
  "properties": {
    "type": { "enum": ["capability", "execution", "config", "run", "plugin", "formatter", "schema"] },
    "id": { "type": "string", "minLength": 1 },
    "path": { "type": "string", "minLength": 1 },
    "query": { "type": "string", "minLength": 1 },
    "filter": { "type": "object" },
    "include": {
      "type": "array",
      "items": { "enum": ["steps", "events", "manifest", "state", "document", "scripts"] },
      "uniqueItems": true
    },
    "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
    "format": { "type": "string" },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": { "path": { "type": "string", "minLength": 1 } }
    }
  },
  "allOf": [
    { "not": { "required": ["id", "query"] } },
    { "not": { "required": ["id", "path"] } },
    { "not": { "required": ["path", "query"] } },
    {
      "if": {
        "properties": { "filter": { "type": "object", "required": ["dir"] } },
        "required": ["filter"]
      },
      "then": {
        "properties": { "type": { "const": "execution" } },
        "not": { "anyOf": [{ "required": ["id"] }, { "required": ["path"] }, { "required": ["query"] }] }
      }
    },
    {
      "if": {
        "properties": { "include": { "type": "array", "contains": { "const": "scripts" } } },
        "required": ["include"]
      },
      "then": { "properties": { "type": { "const": "execution" } } }
    }
  ]
}