{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ecp://protocol/execution.base.schema.json",
  "title": "ECP execution manifest (base)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "steps"],
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": "@executioncontrolprotocol.execution" },
    "version": { "const": "2.0" },
    "execution": { "$ref": "#/$defs/executionBlock" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/node" }
    },
    "detached": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/node" }
    }
  },
  "$defs": {
    "executionBlock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
        "label": { "type": "string" },
        "description": { "type": "string" },
        "accepts": { "$ref": "#/$defs/objectSchema" },
        "returns": { "$ref": "#/$defs/objectSchema" }
      }
    },
    "objectSchema": {
      "type": "object",
      "required": ["type", "properties"],
      "properties": {
        "type": { "const": "object" },
        "properties": { "type": "object" },
        "required": { "type": "array", "items": { "type": "string" } },
        "additionalProperties": {}
      }
    },
    "nodeId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" },
    "node": {
      "allOf": [
        {
          "if": {
            "type": "object",
            "required": ["type"],
            "properties": { "type": { "const": "if" } }
          },
          "then": { "$ref": "#/$defs/if" }
        },
        {
          "if": {
            "type": "object",
            "required": ["type"],
            "properties": { "type": { "const": "loop" } }
          },
          "then": { "$ref": "#/$defs/loop" }
        },
        {
          "if": {
            "type": "object",
            "required": ["type"],
            "properties": { "type": { "const": "parallel" } }
          },
          "then": { "$ref": "#/$defs/parallel" }
        },
        {
          "if": {
            "not": {
              "type": "object",
              "required": ["type"],
              "properties": { "type": { "enum": ["if", "loop", "parallel"] } }
            }
          },
          "then": { "$ref": "#/$defs/step" }
        }
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "uses"],
      "properties": {
        "type": { "const": "step" },
        "id": { "$ref": "#/$defs/nodeId" },
        "label": { "type": "string" },
        "uses": { "type": "string", "pattern": "^@[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*\\.[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "config": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]{0,63}$" },
        "input": { "$ref": "#/$defs/inputObject" },
        "accepts": { "$ref": "#/$defs/objectSchema" },
        "returns": { "$ref": "#/$defs/objectSchema" },
        "script": { "$ref": "#/$defs/plainScript" },
        "expression": { "type": "string", "minLength": 1 },
        "as": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "mode": { "enum": ["create", "replace", "merge", "append"] },
        "persist": { "type": "boolean" }
      }
    },
    "if": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "then"],
      "properties": {
        "type": { "const": "if" },
        "id": { "$ref": "#/$defs/nodeId" },
        "label": { "type": "string" },
        "accepts": { "$ref": "#/$defs/objectSchema" },
        "input": { "$ref": "#/$defs/inputObject" },
        "expression": { "type": "string", "minLength": 1 },
        "script": { "$ref": "#/$defs/plainScript" },
        "as": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "then": {
          "type": "array",
          "items": { "$ref": "#/$defs/node" }
        },
        "else": {
          "type": "array",
          "items": { "$ref": "#/$defs/node" }
        }
      },
      "oneOf": [
        { "required": ["expression"], "not": { "required": ["script"] } },
        { "required": ["script"], "not": { "required": ["expression"] } },
        { "not": { "anyOf": [{ "required": ["expression"] }, { "required": ["script"] }] } }
      ]
    },
    "loop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "mode", "as", "input", "steps"],
      "properties": {
        "type": { "const": "loop" },
        "id": { "$ref": "#/$defs/nodeId" },
        "label": { "type": "string" },
        "mode": { "enum": ["for", "forEach"] },
        "input": { "$ref": "#/$defs/inputObject" },
        "as": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "concurrency": { "type": "integer", "minimum": 1, "maximum": 32 },
        "onError": { "enum": ["fail", "continue"] },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/$defs/node" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "for" } }, "required": ["mode"] },
          "then": {
            "properties": {
              "concurrency": false,
              "onError": false
            }
          }
        },
        {
          "if": { "properties": { "mode": { "const": "forEach" } }, "required": ["mode"] },
          "then": {}
        }
      ]
    },
    "parallel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "paths"],
      "properties": {
        "type": { "const": "parallel" },
        "id": { "$ref": "#/$defs/nodeId" },
        "label": { "type": "string" },
        "accepts": { "$ref": "#/$defs/objectSchema" },
        "input": { "$ref": "#/$defs/inputObject" },
        "as": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "maxConcurrency": { "type": "integer", "minimum": 1 },
        "paths": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "array",
            "items": { "$ref": "#/$defs/node" }
          }
        }
      }
    },
    "plainScript": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lang"],
      "properties": {
        "lang": { "const": "js" },
        "source": { "type": "string" },
        "path": { "type": "string", "minLength": 1 },
        "ecmaVersion": { "type": "integer", "minimum": 3 }
      },
      "oneOf": [
        { "required": ["source"], "not": { "required": ["path"] } },
        { "required": ["path"], "not": { "required": ["source"] } }
      ]
    },
    "inputObject": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/value" }
    },
    "value": {
      "if": {
        "type": "object",
        "required": ["$ref"]
      },
      "then": { "$ref": "#/$defs/refValue" },
      "else": {
        "if": { "type": "object", "required": ["$state"] },
        "then": { "$ref": "#/$defs/stateValue" },
        "else": {
            "if": { "type": "object", "required": ["$script"] },
            "then": { "$ref": "#/$defs/scriptValue" },
            "else": {
              "if": { "type": "object", "required": ["$secret"] },
              "then": false,
              "else": {
                "if": { "type": "object", "required": ["$env"] },
                "then": false,
                "else": { "$ref": "#/$defs/plain" }
              }
            }
        }
      }
    },
    "refValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$ref"],
      "properties": {
        "$ref": {
          "oneOf": [
            { "type": "string", "pattern": "^state(?:\\.(?:[A-Za-z_$][A-Za-z0-9_$-]*|[0-9]+))+$" },
            {
              "type": "array",
              "minItems": 2,
              "items": { "type": "string", "pattern": "^state(?:\\.(?:[A-Za-z_$][A-Za-z0-9_$-]*|[0-9]+))+$" }
            }
          ]
        },
        "optional": { "type": "boolean" },
        "fallback": {}
      }
    },
    "stateValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$state"],
      "properties": {
        "$state": { "type": "string", "pattern": "^(?:[A-Za-z_$][A-Za-z0-9_$-]*|[0-9]+)(?:\\.(?:[A-Za-z_$][A-Za-z0-9_$-]*|[0-9]+))*$" }
      }
    },
    "scriptValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$script"],
      "properties": {
        "$script": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lang"],
          "properties": {
            "lang": { "const": "js" },
            "source": { "type": "string" },
            "path": { "type": "string", "minLength": 1 },
            "params": {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/value" }
            },
            "ecmaVersion": { "type": "integer", "minimum": 3 }
          },
          "oneOf": [
            { "required": ["source"], "not": { "required": ["path"] } },
            { "required": ["path"], "not": { "required": ["source"] } }
          ]
        }
      }
    },
    "plain": {
      "anyOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        { "type": "array", "items": { "$ref": "#/$defs/value" } },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/value" }
        }
      ]
    }
  }
}
