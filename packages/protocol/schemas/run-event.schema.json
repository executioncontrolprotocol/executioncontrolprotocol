{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ecp://protocol/run-event.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["seq", "at", "type", "data"],
  "properties": {
    "seq": { "type": "integer", "minimum": 1 },
    "at": { "type": "string" },
    "type": {
      "enum": [
        "run.start",
        "step.start",
        "step.skip",
        "step.end",
        "step.error",
        "step.warning",
        "branch.select",
        "loop.round",
        "loop.exhausted",
        "forEach.start",
        "forEach.item.start",
        "forEach.item.end",
        "forEach.item.error",
        "forEach.end",
        "run.interrupted",
        "run.resume",
        "run.end"
      ]
    },
    "data": { "type": "object" }
  }
}
