{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ecp://protocol/config.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "id", "plugin", "values", "objectVersion", "updatedAt"],
  "properties": {
    "schema": { "const": "@executioncontrolprotocol.config" },
    "version": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]{0,63}$" },
    "plugin": { "type": "string", "minLength": 1 },
    "values": { "type": "object" },
    "objectVersion": { "type": "integer", "minimum": 1 },
    "updatedAt": { "type": "string", "minLength": 1 }
  }
}
