{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ecp://protocol/execute.input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "execution": {},
    "input": { "type": "object" },
    "mode": { "enum": ["run", "validate"] },
    "wait": { "type": "boolean" },
    "waitTimeoutMs": { "type": "integer", "minimum": 0 },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": { "path": { "type": "string", "minLength": 1 } }
    },
    "clientRequestId": { "type": "string" },
    "resume": { "type": "string", "minLength": 1 },
    "cancel": { "type": "string", "minLength": 1 }
  },
  "oneOf": [
    { "required": ["execution"], "not": { "anyOf": [{ "required": ["resume"] }, { "required": ["cancel"] }] } },
    { "required": ["resume"], "not": { "anyOf": [{ "required": ["execution"] }, { "required": ["cancel"] }] } },
    { "required": ["cancel"], "not": { "anyOf": [{ "required": ["execution"] }, { "required": ["resume"] }] } }
  ]
}
