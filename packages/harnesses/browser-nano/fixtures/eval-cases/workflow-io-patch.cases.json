{
  "cases": [
    {
      "id": "wf-patch-io-01",
      "suite": "workflow-patch",
      "title": "Add ACCEPTS to echo workflow",
      "harness": "workflow-authoring",
      "model": "default",
      "baselineWorkflow": "workflows/echo-workflow.json",
      "input": {
        "request": "PATCH WORKFLOW echo-test: add ACCEPTS WITH value:string! and UPDATE STEP echo WITH value = REF value."
      },
      "assertions": {
        "deterministic": [
          { "kind": "invokeSuccess" },
          { "kind": "artifactSchema", "value": "@executioncontrolprotocol.workflow" },
          { "kind": "validationValid" },
          { "kind": "workflowAcceptsHasProperties", "properties": ["value"] },
          { "kind": "workflowAcceptsRefUsed", "property": "value" }
        ],
        "judge": { "enabled": false }
      }
    },
    {
      "id": "wf-patch-io-02",
      "suite": "workflow-patch",
      "title": "Add RETURNS to accepts workflow",
      "harness": "workflow-authoring",
      "model": "default",
      "baselineWorkflow": "workflows/echo-accepts-workflow.json",
      "input": {
        "request": "Add RETURNS OUT echo:object! to workflow echo-accepts."
      },
      "assertions": {
        "deterministic": [
          { "kind": "invokeSuccess" },
          { "kind": "artifactSchema", "value": "@executioncontrolprotocol.workflow" },
          { "kind": "validationValid" },
          { "kind": "workflowReturnsHasProperties", "properties": ["echo"] },
          { "kind": "workflowReturnsMapsAs", "property": "echo", "asKey": "echo" }
        ],
        "judge": { "enabled": false }
      }
    },
    {
      "id": "wf-patch-io-03",
      "suite": "workflow-patch",
      "title": "Change RETURNS property",
      "harness": "workflow-authoring",
      "model": "default",
      "baselineWorkflow": "workflows/echo-accepts-returns-workflow.json",
      "input": {
        "request": "Change RETURNS OUT echo:object! to OUT result:object! on workflow echo-from-input."
      },
      "assertions": {
        "deterministic": [
          { "kind": "invokeSuccess" },
          { "kind": "artifactSchema", "value": "@executioncontrolprotocol.workflow" },
          { "kind": "validationValid" },
          { "kind": "workflowReturnsHasProperties", "properties": ["result"] }
        ],
        "judge": { "enabled": false }
      }
    },
    {
      "id": "wf-patch-io-04",
      "suite": "workflow-patch",
      "title": "CLEAR RETURNS",
      "harness": "workflow-authoring",
      "model": "default",
      "baselineWorkflow": "workflows/echo-accepts-returns-workflow.json",
      "input": {
        "request": "Remove workflow returns with CLEAR RETURNS but keep ACCEPTS value."
      },
      "assertions": {
        "deterministic": [
          { "kind": "invokeSuccess" },
          { "kind": "artifactSchema", "value": "@executioncontrolprotocol.workflow" },
          { "kind": "validationValid" },
          { "kind": "workflowAcceptsHasProperties", "properties": ["value"] },
          { "kind": "workflowReturnsAbsent" }
        ],
        "judge": { "enabled": false }
      }
    },
    {
      "id": "wf-patch-io-05",
      "suite": "workflow-patch",
      "title": "Rename ACCEPTS property",
      "harness": "workflow-authoring",
      "model": "default",
      "baselineWorkflow": "workflows/echo-accepts-returns-workflow.json",
      "input": {
        "request": "Rename ACCEPTS field value to message and UPDATE STEP echo WITH value = REF message."
      },
      "assertions": {
        "deterministic": [
          { "kind": "invokeSuccess" },
          { "kind": "artifactSchema", "value": "@executioncontrolprotocol.workflow" },
          { "kind": "validationValid" },
          { "kind": "workflowAcceptsHasProperties", "properties": ["message"] },
          { "kind": "workflowAcceptsRefUsed", "property": "message" }
        ],
        "judge": { "enabled": false }
      }
    },
    {
      "id": "wf-patch-io-06",
      "suite": "workflow-patch",
      "title": "Preserve I/O on label patch",
      "harness": "workflow-authoring",
      "model": "default",
      "baselineWorkflow": "workflows/echo-accepts-returns-workflow.json",
      "input": {
        "request": "Change echo step label to Patched Echo only."
      },
      "assertions": {
        "deterministic": [
          { "kind": "invokeSuccess" },
          { "kind": "artifactSchema", "value": "@executioncontrolprotocol.workflow" },
          { "kind": "validationValid" },
          { "kind": "stepLabel", "stepId": "echo", "value": "Patched Echo" },
          { "kind": "workflowAcceptsHasProperties", "properties": ["value"] },
          { "kind": "workflowReturnsHasProperties", "properties": ["echo"] }
        ],
        "judge": { "enabled": false }
      }
    }
  ]
}
