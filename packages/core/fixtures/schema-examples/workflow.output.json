{
  "schema": "@executioncontrolprotocol.workflow",
  "version": "1.0.0",
  "workflow": {
    "id": "echo-from-input",
    "label": "Echo from input",
    "accepts": {
      "type": "object",
      "properties": {
        "value": { "type": "string" }
      },
      "required": ["value"]
    },
    "returns": {
      "type": "object",
      "properties": {
        "echo": { "type": "object" }
      },
      "required": ["echo"]
    }
  },
  "steps": [
    {
      "type": "step",
      "id": "echo",
      "label": "Echo",
      "uses": "@executioncontrolprotocol/test.echo",
      "input": { "value": { "$ref": "state.value" } },
      "as": "echo"
    }
  ]
}
