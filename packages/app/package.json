{
  "name": "@executioncontrolprotocol/app",
  "version": "0.60.0",
  "private": true,
  "description": "ECP App: execution graph, run view and history, served by the host at /app/.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b && tsc -p tsconfig.web.json && vite build",
    "build:web": "tsc -p tsconfig.web.json && vite build",
    "dev": "vite",
    "typecheck:web": "tsc -p tsconfig.web.json"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.4",
    "@executioncontrolprotocol/protocol": "workspace:*"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.3.0",
    "@xyflow/react": "^12.12.1",
    "autoprefixer": "^10.5.0",
    "lucide-react": "^1.73.0",
    "monaco-editor": "^0.56.0",
    "postcss": "^8.5.15",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.19",
    "typescript": "catalog:",
    "vite": "^8.3.8"
  }
}
