{
  "name": "@executioncontrolprotocol/extensions",
  "version": "0.13.1",
  "description": "Aggregator that registers first-party ECP extensions",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@executioncontrolprotocol/extension-memory": "workspace:^",
    "@executioncontrolprotocol/extension-ollama": "workspace:^",
    "@executioncontrolprotocol/extension-openai": "workspace:^",
    "@executioncontrolprotocol/extension-storage": "workspace:^",
    "@executioncontrolprotocol/extension-telemetry": "workspace:^",
    "@executioncontrolprotocol/format-eql": "workspace:^",
    "@executioncontrolprotocol/format-mermaid": "workspace:^",
    "@executioncontrolprotocol/format-reactflow": "workspace:^",
    "@executioncontrolprotocol/format-toon": "workspace:^"
  },
  "peerDependencies": {
    "@executioncontrolprotocol/core": "workspace:^",
    "@executioncontrolprotocol/types": "workspace:^",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@executioncontrolprotocol/core": "workspace:^",
    "@executioncontrolprotocol/types": "workspace:^",
    "typescript": "catalog:",
    "zod": "catalog:"
  }
}
