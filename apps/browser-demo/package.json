{
  "name": "@executioncontrolprotocol/browser-demo",
  "version": "0.14.0",
  "private": true,
  "type": "module",
  "description": "ECP Graph Editor — browser demo app (Vite + React)",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "pnpm run typecheck && pnpm run lint:yaml",
    "build": "pnpm run typecheck && vite build",
    "build:pages": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "pnpm run lint && pnpm run secrets:scan && pnpm run check:no-file-deps && pnpm test && pnpm run build",
    "secrets:scan": "secretlint \"**/*\"",
    "check:no-file-deps": "node scripts/check-no-file-deps.mjs",
    "lint:yaml": "node scripts/lint-yaml.mjs",
    "supabase:push": "supabase db push",
    "supabase:status": "supabase migration list"
  },
  "lint-staged": {
    "*": [
      "secretlint --no-glob"
    ],
    "*.{yml,yaml}": [
      "node scripts/lint-yaml.mjs"
    ]
  },
  "dependencies": {
    "@executioncontrolprotocol/adobe-firefly-services": "workspace:*",
    "@executioncontrolprotocol/anthropic": "workspace:*",
    "@executioncontrolprotocol/azure-blob-storage": "workspace:*",
    "@executioncontrolprotocol/browser": "workspace:*",
    "@executioncontrolprotocol/chrome-ai": "workspace:*",
    "@executioncontrolprotocol/core": "workspace:*",
    "@executioncontrolprotocol/extension-ollama": "workspace:*",
    "@executioncontrolprotocol/extension-openai": "workspace:*",
    "@executioncontrolprotocol/extension-storage": "workspace:*",
    "@executioncontrolprotocol/fal": "workspace:*",
    "@executioncontrolprotocol/format-eql": "workspace:*",
    "@executioncontrolprotocol/format-mermaid": "workspace:*",
    "@executioncontrolprotocol/format-reactflow": "workspace:*",
    "@executioncontrolprotocol/format-toon": "workspace:*",
    "@executioncontrolprotocol/harnesses-browser-coding": "workspace:*",
    "@executioncontrolprotocol/harnesses-browser-nano": "workspace:*",
    "@executioncontrolprotocol/image-sharp": "workspace:*",
    "@executioncontrolprotocol/jsonata": "workspace:*",
    "@executioncontrolprotocol/types": "workspace:*",
    "@monaco-editor/react": "^4.7.0",
    "@supabase/supabase-js": "^2.107.0",
    "@xyflow/react": "^12.11.3",
    "esbuild-wasm": "^0.25.0",
    "mermaid": "^11.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.0",
    "lint-staged": "^17.3.0",
    "monaco-editor": "^0.56.0",
    "postcss": "^8.5.15",
    "secretlint": "^13.0.4",
    "supabase": "^2.105.0",
    "tailwindcss": "^3.4.19",
    "typescript": "catalog:",
    "vite": "^6.4.3",
    "vitest": "catalog:",
    "yaml": "catalog:"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.61.1"
  }
}
